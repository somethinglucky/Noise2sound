{
  "name": "noise2sound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node server-dist/index.js",
    "dev:server": "tsc -p tsconfig.server.json && node --env-file=.env server-dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@soundtouchjs/core": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^23.0.0",
    "wasm-media-encoders": "^0.7.0",
    "wavesurfer.js": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
