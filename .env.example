# Copy to /etc/noise2sound.env on the droplet (never commit the real one).
APP_URL=https://noise2sound.vbuds.app
PORT=8787
DATA_DIR=/var/lib/noise2sound

# Stripe (dashboard.stripe.com): use test keys first (sk_test_...), live keys when ready.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (resend.com) sends the sign-in emails.
RESEND_API_KEY=re_xxx
MAIL_FROM=Noise2sound <login@vbuds.app>
